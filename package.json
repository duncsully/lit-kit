{
  "name": "lit-kit",
  "version": "0.0.0",
  "description": "A set of utilities for using lit-html with signals.",
  "homepage": "https://github.com/duncsully/lit-kit#readme",
  "bugs": {
    "url": "https://github.com/duncsully/lit-kit/issues"
  },
  "license": "MIT",
  "author": "duncsully",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duncsully/lit-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./directives/batchEvent": "./dist/directives/batchEvent.mjs",
    "./directives/bind": "./dist/directives/bind.mjs",
    "./directives/effects": "./dist/directives/effects.mjs",
    "./directives/memoize": "./dist/directives/memoize.mjs",
    "./directives/when": "./dist/directives/when.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --browser.headless",
    "test:ui": "vp test --watch",
    "check": "vp check",
    "prepare": "vp config && vp run build"
  },
  "dependencies": {
    "@lit-labs/preact-signals": "^1.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@vitest/browser-playwright": "^5.1.0",
    "bumpp": "^11.1.0",
    "happy-dom": "^20.12.0",
    "lit-html": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-lit": "^1.0.1"
  },
  "peerDependencies": {
    "lit-html": "^3.3.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}

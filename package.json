{
  "name": "lit-kit",
  "version": "0.0.0",
  "description": "A set of utilities for using lit-html with signals.",
  "homepage": "https://github.com/duncsully/lit-kit#readme",
  "bugs": {
    "url": "https://github.com/duncsully/lit-kit/issues"
  },
  "license": "MIT",
  "author": "duncsully",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duncsully/lit-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@lit-labs/signals": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "lit-html": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "lit-html": "^3.3.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
